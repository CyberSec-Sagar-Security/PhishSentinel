# PhishSentinel .gitignore

# Environment & secrets — NEVER commit API keys
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Virtual environments
venv/
env/
.venv/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Raw data — do not commit email corpora (privacy/legal)
data/raw/*.csv
data/raw/*.eml
data/raw/*.mbox
data/raw/*.json
data/raw/*.zip
data/raw/*/
data/processed/
data/processed/embedding_cache/

# Model files — large binaries; use HF Hub for storage
models/**/*.pkl
models/**/*.joblib
models/**/*.bin
models/**/*.pt
models/**/*.pth
models/*.pkl
models/*.joblib
models/*.bin
models/*.pt
models/*.pth

# MLflow tracking
mlruns/
mlflow.db

# Test coverage
.coverage
htmlcov/
.pytest_cache/
.tox/

# Reports (auto-generated)
reports/figures/*.pdf
reports/model_comparison.csv

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# CatBoost training artefacts
catboost_info/

# Raw dataset archives
*.zip
*.tar.gz
*.tar.bz2

# Internal project planning/state documents
PHISHLENS_MASTER_PROMPT.md
TEMP_PROJECT_STATE.md
PhishLens.md

# Sample email test files — do not publish
samples eamil/
