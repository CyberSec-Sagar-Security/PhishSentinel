PHISHLENS_MASTER_PROMPT.md
TEMP_PROJECT_STATE.md
PhishLens.md
app.py

# MLflow SQLite database (runtime artefact)
mlflow.db

# CatBoost training artefacts
catboost_info/

# Logs
logs/

# OS
.DS_Store
Thumbs.db
