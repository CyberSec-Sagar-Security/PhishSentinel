# PhishLens — Environment Variables Template
# Copy this file to .env and fill in your API keys.

# OpenAI ChatGPT API (AI-powered phishing analysis layer)
# Register at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# VirusTotal API (URL/domain reputation — 500 lookups/day free tier)
# Register at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Google Safe Browsing API (Chrome-level threat intelligence)
# Register at: https://console.cloud.google.com/
GOOGLE_SAFE_BROWSING_API_KEY=your_gsb_api_key_here

# AbuseIPDB API (Sender IP reputation — 1,000 checks/day free tier)
# Register at: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# URLScan.io API (Live page scan + phishing verdict)
# Register at: https://urlscan.io/user/signup
URLSCAN_API_KEY=your_urlscan_api_key_here

# WhoisXML API (WHOIS enrichment for domain-age / registrar features)
# Register free at: https://user.whoisxmlapi.com/sign-up (500 queries/month)
WHOISXML_API_KEY=your_key_here

# Hugging Face token (required to upload/download models > 100MB)
# Generate at: https://huggingface.co/settings/tokens (read access is enough)
HF_TOKEN=your_token_here

# IPQualityScore API (URL/email/IP risk scoring)
# Register free at: https://www.ipqualityscore.com/create-account
IPQS_API_KEY=your_ipqs_api_key_here
