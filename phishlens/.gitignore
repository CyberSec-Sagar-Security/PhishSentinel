# PhishLens .gitignore

# Environment & secrets — NEVER commit API keys
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Virtual environments
venv/
env/
.venv/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Raw data — do not commit email corpora (privacy/legal)
data/raw/*.csv
data/raw/*.eml
data/raw/*.mbox
data/raw/*.json
data/raw/*.zip
data/raw/*/
data/processed/
data/processed/embedding_cache/

# Model files — large binaries; use HF Hub for storage
models/*.pkl
models/*.joblib
models/*.bin
models/*.pt
models/*.pth
models/saved/*.pkl
models/saved/*.joblib
models/saved/*.bin
models/saved/*.pt
models/saved/*.pth

# MLflow tracking
mlruns/

# Test coverage
.coverage
htmlcov/
.pytest_cache/
.tox/

# Reports (auto-generated — large/intermediate only)
reports/figures/*.pdf
reports/model_comparison.csv
# Note: reports/figures/*.png (confusion matrices) are committed for the Performance Dashboard

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# CatBoost training artefacts (auto-generated during training)
catboost_info/
../catboost_info/

# Temporary project state files
TEMP_PROJECT_STATE.md

# MLflow SQLite database (generated at runtime — use mlruns/ for artifacts)
mlflow.db

# Numpy embedding caches (large binary arrays — stored via HF Hub)
*.npy

# Auto-generated verification output
verify_output.txt
